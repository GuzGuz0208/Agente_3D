---
/**
 * The stage for the 3D avatar (mounted by src/avatar/, another lane) with the
 * orb as visual fallback, the live status badge, the subtitle bubble and the
 * two voice controls: talk and mute.
 *
 * «Avatar 3D / Orbe»: the person can hide the 3D model and keep only the orb.
 * The choice is stored in localStorage (`ips.avatar` = "on" | "off"), mirrored
 * in `#avatar-stage[data-avatar-enabled]` and announced on `window` with the
 * CustomEvent `avatar:toggle` ({ detail: { enabled } }). While it is off the
 * avatar module is never loaded (no .vrm download, no WebGL); if it was
 * mounted, its host is disposed. From the orb to the slime there is an entrance:
 * `data-entrance="eat"` keeps the orb on screen while the slime hops in and eats
 * it (scripts/avatar-host.ts); with reduced motion it is a plain switch.
 *
 * On phones and upright tablets the stage is compact and the talk button moves
 * to the composer at the bottom edge (see Chat.astro), within reach of the thumb.
 *
 * «Jugar» (play mode, logic in scripts/play-mode.ts): the stage fills the screen,
 * the phone's tilt rolls the slime, its hits against the edges vibrate the phone
 * (Android), and the conversation goes on: talk/stop, mute and the subtitle stay
 * on the stage. It is offered only while the 3D character is on screen and never
 * starts on its own. «Salir del juego», Esc or leaving fullscreen restore everything.
 */
import CircleDot from "@lucide/astro/icons/circle-dot";
import Droplet from "@lucide/astro/icons/droplet";
import Gamepad2 from "@lucide/astro/icons/gamepad-2";
import Maximize from "@lucide/astro/icons/maximize";
import Mic from "@lucide/astro/icons/mic";
import Rotate3d from "@lucide/astro/icons/rotate-3d";
import Square from "@lucide/astro/icons/square";
import UserRound from "@lucide/astro/icons/user-round";
import VolumeX from "@lucide/astro/icons/volume-x";
import X from "@lucide/astro/icons/x";
import ZoomIn from "@lucide/astro/icons/zoom-in";
import ZoomOut from "@lucide/astro/icons/zoom-out";
import Orb from "./Orb.astro";
---

<section class="stage-card" id="stage" aria-label="Voz">
  <div id="avatar-stage" data-avatar="absent">
    <canvas id="avatar-canvas" aria-hidden="true"></canvas>
    <div class="fallback">
      <Orb />
    </div>

    <p class="live-badge" role="status" aria-live="polite">
      <span class="dot" aria-hidden="true"></span>
      <span id="state-badge" data-testid="state-badge">En línea</span>
    </p>

    <div class="stage-tools" role="group" aria-label="Vista">
      <button type="button" class="tool tool-play" id="btn-play" data-testid="play-button" title="Jugar: pantalla completa; inclina el celular o arrastra al personaje">
        <Gamepad2 aria-hidden="true" /><span class="tool-label">Jugar</span>
      </button>
      <button type="button" class="tool tool-mute" data-testid="mute-button-stage" data-mute disabled aria-label="Silenciar" title="Silenciar (Esc)"><VolumeX aria-hidden="true" /></button>
      <button type="button" class="tool" id="btn-fullscreen" aria-label="Pantalla completa" title="Pantalla completa"><Maximize aria-hidden="true" /></button>
      <button type="button" class="tool tool-cam" id="btn-camera" aria-label="Reiniciar cámara" title="Reiniciar cámara"><Rotate3d aria-hidden="true" /></button>
      <button type="button" class="tool tool-cam" id="btn-zoom-in" aria-label="Acercar" title="Acercar"><ZoomIn aria-hidden="true" /></button>
      <button type="button" class="tool tool-cam" id="btn-zoom-out" aria-label="Alejar" title="Alejar"><ZoomOut aria-hidden="true" /></button>
    </div>

    <div class="stage-mode" role="group" aria-label="Qué se muestra">
      <button type="button" data-avatar-mode="slime" data-testid="avatar-mode-3d" aria-pressed="true" title="Mostrar el slime">
        <Droplet aria-hidden="true" /> <span>Slime</span>
      </button>
      <button type="button" data-avatar-mode="humano" data-testid="avatar-mode-human" aria-pressed="false" title="Mostrar el avatar 3D animado">
        <UserRound aria-hidden="true" /> <span>Avatar 3D</span>
      </button>
      <button type="button" data-avatar-mode="off" data-testid="avatar-mode-orb" aria-pressed="false" title="Mostrar solo el orbe">
        <CircleDot aria-hidden="true" /> <span>Orbe</span>
      </button>
    </div>

    <!-- Shown only while the voice connects: tells the person to wait before speaking. -->
    <p class="wait-note" id="wait-note" data-testid="wait-note" aria-hidden="true">
      <span class="wait-spin" aria-hidden="true"></span>
      <span><strong>Preparando la voz…</strong><span class="wait-more"> Espera unos segundos; te aviso cuando puedas hablar.</span></span>
    </p>

    <p class="subtitle" id="subtitle" data-testid="subtitle" aria-hidden="true" hidden></p>
    <!-- Screen readers get finished utterances only, never every partial. -->
    <div class="sr-only" id="subtitle-live" aria-live="polite" aria-atomic="true"></div>

    <!-- Play mode only: a short hint once the sensor answers, and the controls that stay on screen. -->
    <p class="play-note" id="play-note" data-testid="play-note" role="status" aria-live="polite"></p>
    <div class="play-bar" role="group" aria-label="Juego">
      <button type="button" class="btn play-exit" id="btn-play-exit" data-testid="play-exit" aria-keyshortcuts="Escape">
        <X aria-hidden="true" /> Salir del juego
      </button>
      <button class="btn btn-talk" type="button" id="btn-play-talk" data-testid="mic-button-play" data-running="false">
        <span class="when-stopped"><Mic aria-hidden="true" /> Hablar</span>
        <span class="when-running"><Square aria-hidden="true" /> Detener</span>
        <span class="when-waiting"><span class="wait-spin" aria-hidden="true"></span> Conectando…</span>
      </button>
    </div>
  </div>

  <div class="stage-controls">
    <button class="btn btn-talk" type="button" id="btn-toggle" data-testid="mic-button" data-running="false">
      <span class="when-stopped"><Mic aria-hidden="true" /> Hablar</span>
      <span class="when-running"><Square aria-hidden="true" /> Detener</span>
      <span class="when-waiting"><span class="wait-spin" aria-hidden="true"></span> Conectando…</span>
    </button>
    <button class="btn" type="button" id="btn-mute" data-testid="mute-button" data-mute disabled aria-keyshortcuts="Escape" title="Silenciar (Esc)">
      <VolumeX aria-hidden="true" /> Silenciar
    </button>
    <p class="status-sub" id="status-sub">Pulsa Hablar o escribe tu pregunta.</p>
  </div>
</section>

<script>
  import { hostAvatar, type AvatarHost } from "../scripts/avatar-host";
  import { bind, byId, esc, panel } from "../scripts/dom";
  import { startPlay, type PlaySession, type SensorStatus } from "../scripts/play-mode";
  import * as controller from "../voice/controller";
  import { getState, type ConsoleState } from "../voice/store";
  import type { EngineStatus } from "../voice/types";

  const LABEL: Record<EngineStatus, string> = {
    idle: "En línea",
    connecting: "Conectando, espera",
    listening: "Te escucho",
    thinking: "Consultando",
    speaking: "Hablando",
    renewing: "Un momento",
    error: "Hay un problema",
  };

  const SUB: Record<EngineStatus, string> = {
    idle: "Pulsa Hablar o escribe tu pregunta.",
    connecting: "Estoy preparando la voz. Espera unos segundos antes de hablar.",
    listening: "Habla o escribe tu pregunta.",
    thinking: "Buscando en el registro.",
    speaking: "Puedes interrumpir cuando quieras.",
    renewing: "Retomando la conversación donde iba. Espera un momento.",
    error: "Puedes seguir por texto.",
  };

  /** The bubble shows the tail of long speech, so it never covers the avatar. */
  const SUBTITLE_WORDS = 24;
  const tail = (text: string): string => {
    const words = text.split(/\s+/);
    return words.length > SUBTITLE_WORDS ? `… ${words.slice(-SUBTITLE_WORDS).join(" ")}` : text;
  };

  const AVATAR_KEY = "ips.avatar";
  const avatarWanted = (): boolean => {
    try {
      return localStorage.getItem(AVATAR_KEY) !== "off";
    } catch {
      return true;
    }
  };

  /** Same key, values and default as `pickCharacter` in src/avatar/index.ts. */
  const CHARACTER_KEY = "ips.character";
  type Character = "slime" | "humano";
  const storedCharacter = (): Character => {
    try {
      const fromUrl = new URLSearchParams(location.search).get("personaje");
      if (fromUrl === "slime" || fromUrl === "humano") return fromUrl;
      return localStorage.getItem(CHARACTER_KEY) === "humano" ? "humano" : "slime";
    } catch {
      return "slime";
    }
  };

  const ZOOM_MIN = 0.7;
  const ZOOM_MAX = 1.6;

  /** Play mode hint, shown once the sensor answers; long enough to read calmly. */
  const PLAY_NOTE: Record<SensorStatus, string> = {
    on: "Inclina el celular y el slime rodará. También puedes arrastrarlo con el dedo.",
    off: "Tu dispositivo no comparte la inclinación; puedes jugar arrastrándolo.",
  };
  const PLAY_NOTE_GENTLE = "Pediste reducir el movimiento: se moverá con suavidad y sin vibrar.";
  const PLAY_NOTE_MS = 7000;

  panel("stage", (root) => {
    const stage = byId("avatar-stage");
    const toggle = byId<HTMLButtonElement>("btn-toggle");
    const mutes = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-mute]"));
    const subtitle = byId("subtitle");
    const live = byId("subtitle-live");
    let zoom = 1;
    let announced = "";

    const modes = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-avatar-mode]"));
    let avatar: AvatarHost | null = null;
    let canvasUsed = false;
    let character: Character = storedCharacter();
    let entranceTimer: ReturnType<typeof setTimeout> | undefined;

    const playButton = byId<HTMLButtonElement>("btn-play");
    const playTalk = byId<HTMLButtonElement>("btn-play-talk");
    const playNote = byId("play-note");
    let play: PlaySession | null = null;
    let playNoteTimer: ReturnType<typeof setTimeout> | undefined;
    let zoomBeforePlay = 1;

    /** Mounts the 3D avatar. A canvas that already held a disposed WebGL context is replaced first. */
    const mountAvatar = (): void => {
      let canvas = byId<HTMLCanvasElement>("avatar-canvas");
      if (!stage || !canvas || avatar) return;
      if (canvasUsed) {
        const fresh = canvas.cloneNode(false) as HTMLCanvasElement;
        canvas.replaceWith(fresh);
        canvas = fresh;
      }
      canvasUsed = true;
      avatar = hostAvatar(stage, canvas);
    };

    /** One pressed button: the character on screen, or the orb. */
    const pressModes = (): void => {
      const enabled = stage?.dataset.avatarEnabled === "true";
      for (const b of modes) {
        const mode = b.dataset.avatarMode;
        b.setAttribute("aria-pressed", String(mode === "off" ? !enabled : enabled && mode === character));
      }
    };

    const unmountAvatar = (): void => {
      if (!avatar || !stage) return;
      play?.stop();
      avatar.dispose();
      avatar = null;
      stage.dataset.avatar = "absent";
    };

    /** `announce` is false on first paint: only a change made by the person is an event. */
    const setAvatarEnabled = (enabled: boolean, announce: boolean): void => {
      if (!stage) return;
      stage.dataset.avatarEnabled = String(enabled);
      stage.dataset.character = character;
      pressModes();
      if (enabled) mountAvatar();
      else unmountAvatar();
      if (!announce) return;
      try {
        localStorage.setItem(AVATAR_KEY, enabled ? "on" : "off");
      } catch {
        // Private mode: the choice lasts for this page only.
      }
      window.dispatchEvent(new CustomEvent("avatar:toggle", { detail: { enabled } }));
    };

    /** Slime or the animated 3D avatar; remembered in this browser. From the orb, it is announced like before. */
    const chooseCharacter = (next: Character): void => {
      try {
        localStorage.setItem(CHARACTER_KEY, next);
        // A ?personaje= in the address would win over the stored choice on the next mount.
        const url = new URL(location.href);
        if (url.searchParams.has("personaje")) {
          url.searchParams.delete("personaje");
          history.replaceState(history.state, "", url);
        }
      } catch {
        // Private mode: the avatar module falls back to its default.
      }
      const changed = next !== character;
      character = next;
      if (stage?.dataset.avatarEnabled !== "true") {
        // From the orb to the slime: the slime hops in and eats this very orb (avatar-host.ts flies it
        // into the mouth and removes the mark). Never with reduced motion: then it is a plain switch.
        if (next === "slime" && stage && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
          stage.dataset.entrance = "eat";
          clearTimeout(entranceTimer);
          entranceTimer = setTimeout(() => {
            if (stage.dataset.entrance === "eat") delete stage.dataset.entrance; // never leave the orb over the avatar
          }, 8000);
        }
        setAvatarEnabled(true, true);
        return;
      }
      if (!changed || !stage) return;
      unmountAvatar();
      stage.dataset.character = character;
      pressModes();
      mountAvatar();
    };

    for (const b of modes) {
      b.addEventListener("click", () => {
        const mode = b.dataset.avatarMode;
        if (mode === "off") {
          if (stage?.dataset.avatarEnabled !== "false") setAvatarEnabled(false, true);
        } else if (mode === "slime" || mode === "humano") {
          chooseCharacter(mode);
        }
      });
    }
    setAvatarEnabled(avatarWanted(), false);

    const setZoom = (value: number): void => {
      zoom = Math.min(ZOOM_MAX, Math.max(ZOOM_MIN, value));
      stage?.style.setProperty("--zoom", zoom.toFixed(2));
    };

    const talk = (): void => (getState().running ? controller.stop() : void controller.start());
    toggle?.addEventListener("click", talk);
    playTalk?.addEventListener("click", talk);
    for (const m of mutes) m.addEventListener("click", () => controller.interruptSpeech());
    byId("btn-zoom-in")?.addEventListener("click", () => setZoom(zoom + 0.15));
    byId("btn-zoom-out")?.addEventListener("click", () => setZoom(zoom - 0.15));
    byId("btn-camera")?.addEventListener("click", () => {
      setZoom(1);
      avatar?.resetCamera();
    });
    byId("btn-fullscreen")?.addEventListener("click", () => {
      if (document.fullscreenElement) void document.exitFullscreen();
      else void stage?.requestFullscreen?.().catch(() => undefined);
    });

    // ── «Jugar» ──
    const showPlayNote = (text: string): void => {
      if (!playNote) return;
      clearTimeout(playNoteTimer);
      playNote.textContent = text;
      playNote.dataset.show = "true";
      playNoteTimer = setTimeout(() => (playNote.dataset.show = "false"), PLAY_NOTE_MS);
    };

    /** Runs inside the click: the sensor permission (iOS) and fullscreen both need the gesture. */
    const startPlaying = (): void => {
      const el = stage;
      if (play || !el || !avatar) return;
      zoomBeforePlay = zoom;
      setZoom(1);
      play = startPlay(el, avatar, {
        onSensor: (status, { reducedMotion }) => showPlayNote(reducedMotion ? `${PLAY_NOTE[status]} ${PLAY_NOTE_GENTLE}` : PLAY_NOTE[status]),
        onEnd: () => {
          play = null;
          clearTimeout(playNoteTimer);
          if (playNote) {
            playNote.dataset.show = "false";
            playNote.textContent = "";
          }
          setZoom(zoomBeforePlay);
          el.removeAttribute("tabindex");
          if (playButton?.isConnected) playButton.focus({ preventScroll: true });
        },
      });
      // Keyboard and screen readers continue inside the stage (the rest of the page is inert now).
      el.tabIndex = -1;
      el.focus({ preventScroll: true });
    };
    playButton?.addEventListener("click", startPlaying);
    byId("btn-play-exit")?.addEventListener("click", () => play?.stop());

    const onKey = (e: KeyboardEvent): void => {
      // While playing, Esc leaves the game (play-mode.ts listens after this); it must not also cut the voice.
      if (play) return;
      if (e.key === "Escape" && getState().status === "speaking" && !document.querySelector("dialog[open]")) {
        controller.interruptSpeech();
      }
    };
    document.addEventListener("keydown", onKey);

    const renderStatus = (s: ConsoleState): void => {
      const stopped = !s.running && s.status === "idle";
      const ended = stopped && s.utterances.length > 0;
      const sub = ended
        ? "Conversación detenida. Pulsa Hablar para seguir."
        : s.status === "error" && s.lastError
          ? s.lastError.message
          : SUB[s.status];
      const set = (id: string, text: string): void => {
        const el = byId(id);
        if (el && el.textContent !== text) el.textContent = text;
      };
      set("state-badge", LABEL[s.status]);
      set("status-sub", s.simulated && s.running ? `${sub} Demostración sin audio.` : sub);
      // Connecting or renewing: the stage and the talk buttons all say "wait".
      const waiting = s.running && (s.status === "connecting" || s.status === "renewing");
      if (stage) stage.dataset.waiting = String(waiting);
      for (const b of [toggle, playTalk]) {
        if (!b) continue;
        b.dataset.running = String(s.running);
        b.dataset.waiting = String(waiting);
      }
      for (const m of mutes) m.disabled = s.status !== "speaking";
    };

    const renderSubtitle = (s: ConsoleState): void => {
      if (!subtitle) return;
      const last = s.utterances[s.utterances.length - 1];
      subtitle.hidden = !last;
      if (!last) {
        // After «Reiniciar» nothing of the previous conversation may linger, on screen or for screen readers.
        subtitle.textContent = "";
        if (live) live.textContent = "";
        announced = "";
        return;
      }
      const who = last.role === "agent" ? "Asistente" : "Tú";
      const heard = last.delivered_text ?? last.correction?.text ?? last.text;
      subtitle.className = `subtitle role-${last.role}${last.final ? "" : " partial"}`;
      subtitle.innerHTML = `<b>${who}</b> ${esc(tail(heard))}`;
      if (last.final && live && announced !== last.id) {
        announced = last.id;
        live.textContent = `${who}: ${heard}`;
      }
    };

    const unbindStatus = bind(["status", "meta", "transcript"], renderStatus);
    const unbindSubtitle = bind(["transcript"], renderSubtitle);

    return () => {
      unbindStatus();
      unbindSubtitle();
      play?.stop();
      clearTimeout(playNoteTimer);
      clearTimeout(entranceTimer);
      avatar?.dispose();
      document.removeEventListener("keydown", onKey);
    };
  });
</script>

<style>
  .stage-card {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    min-height: 0;
    min-width: 0;
  }

  #avatar-stage {
    --zoom: 1;
    --orb-size: min(62cqw, 78cqh, 360px);
    container: stage / size;
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background:
      radial-gradient(60% 22% at 50% 96%, var(--stage-floor), transparent 70%),
      radial-gradient(90% 70% at 50% 30%, color-mix(in oklab, var(--state-soft) 70%, var(--white)), transparent 75%),
      linear-gradient(180deg, var(--stage-top), var(--stage-bottom));
    transition: background 0.4s var(--ease);
  }

  #avatar-stage:fullscreen {
    border: 0;
    border-radius: 0;
  }

  #avatar-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transform: scale(var(--zoom));
    transition:
      opacity 0.4s,
      transform 0.25s var(--ease);
  }

  #avatar-stage[data-avatar="ready"] #avatar-canvas {
    opacity: 1;
  }

  /* «Orbe» mode: the orb is the stage, whatever the avatar module was doing. */
  #avatar-stage[data-avatar-enabled="false"] #avatar-canvas {
    display: none;
  }

  #avatar-stage[data-avatar-enabled="false"] .fallback {
    opacity: 1;
    visibility: visible;
  }

  /* Leave the lower part of a tall stage to the caption and the mode switch. */
  @container stage (min-height: 321px) {
    .fallback {
      --orb-size: min(58cqw, 58cqh, 340px);
      padding-bottom: 20cqh;
    }
  }

  #avatar-stage[data-avatar-enabled="false"] .tool-cam {
    display: none;
  }

  .fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transform: scale(var(--zoom));
    transition:
      opacity 0.4s,
      transform 0.25s var(--ease);
  }

  #avatar-stage[data-avatar="ready"] .fallback {
    opacity: 0;
    visibility: hidden;
  }

  /* From the orb to the slime: the orb stays on screen, at its size, until the slime has eaten it
     (avatar-host.ts flies it into the mouth, then removes the mark). */
  #avatar-stage[data-entrance="eat"] .fallback {
    opacity: 1;
    visibility: visible;
    transition: none;
  }

  .live-badge {
    position: absolute;
    top: var(--s-3);
    left: var(--s-3);
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: 0.35rem 0.85rem;
    border-radius: var(--r-pill);
    background: var(--glass);
    box-shadow: var(--shadow-float);
    color: var(--state-ink);
    font-size: var(--t-sm);
    font-weight: 650;
    backdrop-filter: blur(6px);
  }

  .dot {
    width: 0.6rem;
    height: 0.6rem;
    flex: none;
    border-radius: 50%;
    background: var(--state);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--state) 22%, transparent);
    transition:
      background-color 0.3s,
      box-shadow 0.3s;
  }

  .stage-tools {
    position: absolute;
    top: var(--s-3);
    right: var(--s-3);
    display: grid;
    justify-items: end;
    gap: var(--s-2);
  }

  .tool {
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    border: 0;
    border-radius: 50%;
    background: var(--glass);
    box-shadow: var(--shadow-float);
    color: var(--ink-2);
    transition:
      color 0.15s,
      opacity 0.15s,
      transform 0.15s var(--ease);
  }

  .tool:hover:not(:disabled) {
    color: var(--accent-ink);
    transform: scale(1.06);
  }

  .tool:disabled {
    opacity: 0.45;
  }

  /* «Jugar»: a round tool like the others; on a roomy stage it also shows the word. */
  .tool-play {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    width: auto;
    min-width: var(--tap);
    border-radius: var(--r-pill);
    color: var(--primary);
  }

  .tool-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @container stage (min-width: 461px) {
    .tool-play {
      padding: 0 var(--s-4) 0 var(--s-3);
    }

    .tool-label {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
      color: var(--primary-ink);
      font-size: var(--t-sm);
      font-weight: 650;
    }
  }

  /* Only the slime can play: the orb has no body to roll and the animated avatar has no physics. */
  #avatar-stage:not([data-avatar="ready"]) .tool-play,
  #avatar-stage[data-character="humano"] .tool-play {
    display: none;
  }

  /* Narrow phones: while the voice connects, the long «Conectando, espera» badge needs the room. */
  @container stage (max-width: 400px) {
    #avatar-stage[data-waiting="true"] .tool-play {
      display: none;
    }
  }

  /* ── Avatar 3D / Orbe ──────────────────────────────────────────────────── */

  .stage-mode {
    position: absolute;
    left: var(--s-3);
    bottom: var(--s-3);
    display: flex;
    gap: 2px;
    padding: 3px;
    border-radius: var(--r-pill);
    background: var(--glass);
