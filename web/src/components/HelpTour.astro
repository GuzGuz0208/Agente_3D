---
/**
 * Guided help tour: a dimmed layer with a cut-out over the active block and a
 * card that explains it. Mounted once in Base.astro; opened on the first visit
 * and from the help button in the top bar (`[data-help-tour]`).
 * Behaviour lives in src/scripts/help-tour.ts.
 *
 * Every card wears an icon of what it points at. The icons are rendered here
 * once, as <template id="tour-icon-<name>">, and help-tour.ts clones the one
 * named by the step (`icon` in STEPS) into the card's badge.
 */
import ArrowLeft from "@lucide/astro/icons/arrow-left";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import Bot from "@lucide/astro/icons/bot";
import ChartColumn from "@lucide/astro/icons/chart-column";
import Gamepad2 from "@lucide/astro/icons/gamepad-2";
import HeartPulse from "@lucide/astro/icons/heart-pulse";
import Keyboard from "@lucide/astro/icons/keyboard";
import LayoutDashboard from "@lucide/astro/icons/layout-dashboard";
import LifeBuoy from "@lucide/astro/icons/life-buoy";
import Lightbulb from "@lucide/astro/icons/lightbulb";
import MessagesSquare from "@lucide/astro/icons/messages-square";
import Mic from "@lucide/astro/icons/mic";
import ScrollText from "@lucide/astro/icons/scroll-text";
import Shapes from "@lucide/astro/icons/shapes";
import SlidersHorizontal from "@lucide/astro/icons/sliders-horizontal";
import Timer from "@lucide/astro/icons/timer";
import VolumeX from "@lucide/astro/icons/volume-x";
import Wrench from "@lucide/astro/icons/wrench";

/** Keep the names in sync with `TourIcon` in src/scripts/help-tour.ts. */
const icons = {
  bot: Bot,
  "chart-column": ChartColumn,
  "gamepad-2": Gamepad2,
  "heart-pulse": HeartPulse,
  keyboard: Keyboard,
  "layout-dashboard": LayoutDashboard,
  "life-buoy": LifeBuoy,
  lightbulb: Lightbulb,
  "messages-square": MessagesSquare,
  mic: Mic,
  "scroll-text": ScrollText,
  shapes: Shapes,
  "sliders-horizontal": SlidersHorizontal,
  timer: Timer,
  "volume-x": VolumeX,
  wrench: Wrench,
};
---

<div id="help-tour" class="tour" hidden>
  <div class="tour-block" aria-hidden="true"></div>
  <div class="tour-hole" id="help-tour-hole" aria-hidden="true"></div>

  <div
    class="tour-card"
    id="help-tour-card"
    data-testid="tour-card"
    role="dialog"
    aria-modal="true"
    aria-labelledby="help-tour-title"
    aria-describedby="help-tour-text"
    tabindex="-1"
  >
    <div class="tour-top">
      <p class="tour-count" id="help-tour-count" data-testid="tour-count" aria-live="polite"></p>
      <div class="tour-dots" id="help-tour-dots" aria-hidden="true"></div>
      <button type="button" class="btn btn-ghost tour-skip" data-tour-skip data-testid="tour-skip" title="Saltar el recorrido (Esc)">Saltar</button>
    </div>
    <div class="tour-body">
      <span class="tour-icon" id="help-tour-icon" data-testid="tour-icon" aria-hidden="true"></span>
      <div class="tour-words">
        <h2 id="help-tour-title" data-testid="tour-title"></h2>
        <p id="help-tour-text"></p>
      </div>
    </div>
    <div class="tour-actions">
      <button type="button" class="btn" data-tour-prev data-testid="tour-prev" title="Paso anterior (←)">
        <ArrowLeft aria-hidden="true" /> Atrás
      </button>
      <button type="button" class="btn btn-cta tour-next" data-tour-next data-testid="tour-next" title="Paso siguiente (→)">
        <span data-tour-next-label>Siguiente</span>
        <ArrowRight aria-hidden="true" />
      </button>
    </div>
  </div>
  {
    Object.entries(icons).map(([name, Icon]) => (
      <template id={`tour-icon-${name}`}>
        <Icon aria-hidden="true" />
      </template>
    ))
  }
</div>

<script>
  import { initHelpTour } from "../scripts/help-tour";

  initHelpTour();
</script>

<style>
  /* Timing, read by help-tour.ts as well (one source of truth):
     --tour-glide  the cut-out, the card and the page scroll travel together;
     --tour-fade   the dimmed layer, the text and the phone sheet fade.
     Older readers lose the thread when a highlight snaps: everything glides on
     a sine ease-in-out (soft start, soft landing, no overshoot). */
  .tour {
    --tour-glide: 640ms;
    --tour-fade: 420ms;
    position: fixed;
    inset: 0;
    z-index: 1000;
    overflow: hidden;
    opacity: 0;
    transition: opacity var(--tour-fade) var(--ease-glide);
  }

  .tour[hidden] {
    display: none;
  }

  .tour[data-open="true"] {
    opacity: 1;
  }

  /* Swallows clicks on the page while the tour is open. */
  .tour-block {
    position: absolute;
    inset: 0;
  }

  /* The cut-out: a transparent box whose huge shadow is the dimmed layer. */
  .tour-hole {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    border-radius: var(--r-md);
    pointer-events: none;
    /* A pale rim (≥ 3:1 against the dimmed layer) with a warm rose halo, the
       colour of the call to action, instead of a violet glow that clashed
       with the pink blocks it framed. */
    box-shadow:
      0 0 0 3px var(--rose-100),
      0 0 0 8px color-mix(in srgb, var(--rose-400) 50%, transparent),
      0 0 30px 8px color-mix(in srgb, var(--rose-400) 40%, transparent),
      0 0 0 200vmax color-mix(in srgb, var(--plum-950) 66%, transparent);
    transition:
      transform var(--tour-glide) var(--ease-glide),
      width var(--tour-glide) var(--ease-glide),
      height var(--tour-glide) var(--ease-glide);
    will-change: transform, width, height;
  }

  .tour-card {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    gap: var(--s-3);
    width: min(22rem, calc(100vw - 1.5rem));
    padding: var(--s-4);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--card);
    color: var(--ink);
    box-shadow:
      var(--shadow-float),
      0 24px 48px -20px color-mix(in srgb, var(--plum-950) 55%, transparent);
    transition:
      transform var(--tour-glide) var(--ease-glide),
      opacity var(--tour-fade) var(--ease-glide);
    will-change: transform;
  }

  /* Phones: the sheet fades out before it changes edge, then fades back in. */
  .tour-card.is-moving {
    opacity: 0;
    transition-duration: var(--tour-glide), calc(var(--tour-fade) / 2);
  }

  .tour-card:focus {
    outline: none;
  }

  .tour.no-anim,
  .tour.no-anim .tour-hole,
  .tour.no-anim .tour-card {
    transition: none;
  }

  .tour-top {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .tour-count {
    padding: 2px var(--s-2);
    border-radius: var(--r-pill);
    background: var(--accent-soft);
    color: var(--accent-ink);
    font-size: var(--t-xs);
    font-weight: var(--w-bold);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .tour-dots {
    display: flex;
    flex: 1;
    gap: 5px;
  }

  .tour-dots :global(span) {
    width: 6px;
    height: 6px;
    border-radius: var(--r-pill);
    background: var(--border-strong);
    transition:
      width var(--tour-fade) var(--ease-glide),
      background-color var(--tour-fade);
  }

  .tour-dots :global(span[data-on]) {
    width: 18px;
    background: var(--rose-500);
  }

  /* A ghost button (global .btn-ghost), tucked into the corner. */
  .tour-skip {
    margin: calc(var(--s-2) * -1) calc(var(--s-2) * -1) calc(var(--s-2) * -1) 0;
    padding: 0 var(--s-3);
  }

  /* The step's icon in a soft tile of the theme, beside the title and text. */
  .tour-body {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--s-3);
  }

  .tour-words {
    display: grid;
    gap: var(--s-1);
  }

  .tour-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--r-md);
    background: var(--primary-soft);
    color: var(--primary);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--primary) 18%, transparent);
  }

  .tour-icon:empty {
    display: none;
  }

  .tour-icon :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  /* The new text settles while the cut-out is still arriving, not before. */
  .tour-body.is-in {
    animation: tour-text var(--tour-fade) var(--ease-glide) calc(var(--tour-glide) / 3) both;
  }

  @keyframes tour-text {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }

  .tour-body h2 {
    font-family: var(--font-display);
    font-size: var(--t-md);
    font-weight: var(--w-bold);
    line-height: var(--lh-tight);
    letter-spacing: -0.015em;
    color: var(--primary-ink);
  }

  .tour-body p {
    color: var(--ink-2);
    font-size: var(--t-sm);
    line-height: var(--lh-body);
  }

  .tour-actions {
    display: flex;
    justify-content: space-between;
    gap: var(--s-2);
  }

  .tour-actions :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  /* Look and states come from the global call to action (.btn-cta). */
  .tour-next {
    flex: 1;
    max-width: 11rem;
    font-size: var(--t-base);
  }

  /* Phones: the card is a sheet on the bottom edge (or the top one, when the
     highlighted block sits in the lower half of the screen). */
  @media (max-width: 430px) {
    .tour-card {
      top: auto;
      right: 0;
      bottom: 0;
      left: 0;
      width: auto;
      padding-bottom: max(var(--s-4), env(safe-area-inset-bottom));
      border-width: 1px 0 0;
      border-radius: var(--r-lg) var(--r-lg) 0 0;
      transform: none;
    }

    .tour-card[data-pos="top"] {
      top: 0;
      bottom: auto;
      padding-top: max(var(--s-4), env(safe-area-inset-top));
      padding-bottom: var(--s-4);
      border-width: 0 0 1px;
      border-radius: 0 0 var(--r-lg) var(--r-lg);
    }

    .tour-next {
      max-width: none;
    }
  }

  /* Reduced motion: every step lands at once (help-tour.ts also jumps the
     scroll instead of gliding it). */
  @media (prefers-reduced-motion: reduce) {
    .tour,
    .tour-hole,
    .tour-card,
    .tour-dots :global(span) {
      transition: none;
    }

    .tour-body.is-in {
      animation: none;
    }
  }
</style>
