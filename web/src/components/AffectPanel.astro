---
/**
 * Emotions and style, live (F-08, F-09; docs/10 §6): the latest estimate
 * (emotion, sentiment, state, method), the valence line per utterance, the
 * text/voice discrepancy and the style in force with its reason.
 * Everything here is an estimate (R-26).
 *
 * Below it, the legend of the lights and faces: every reading with the colour
 * of the stage's edge (`glowFor`), the slime's face (`expressionFor`) and the
 * words of the mood pill (scripts/mood-indicator.ts). «Probar» pushes a sample
 * reading through the store, exactly like the analyst does, and opens the
 * conversation to see it live on the stage.
 */
import ArrowRight from "@lucide/astro/icons/arrow-right";
import type { AvatarExpression } from "../avatar/types";
import { FACE_LABEL, legendRows, type LegendGroup } from "../scripts/mood-indicator";

const GROUPS: { id: LegendGroup; title: string }[] = [
  { id: "emoción", title: "Emociones" },
  { id: "estado", title: "Estados" },
  { id: "tono", title: "Tono general" },
  { id: "neutral", title: "Sin emoción clara" },
];
const rows = legendRows();

/** Schematic drawing of each face of the slime (the faces of src/avatar/expression.ts). */
const EYES = '<ellipse class="f" cx="18" cy="25" rx="2.2" ry="3"/><ellipse class="f" cx="30" cy="25" rx="2.2" ry="3"/>';
const FACE: Record<AvatarExpression, string> = {
  neutral: EYES + '<path class="s" d="M20.5 31.5 Q24 34 27.5 31.5"/>',
  happy: EYES + '<path class="s" d="M18 30.5 Q24 37 30 30.5"/>',
  joyful: EYES + '<path class="f" d="M17.5 30 H30.5 Q30 38 24 38 Q18 38 17.5 30 Z"/>',
  calm: '<path class="s" d="M15 26 Q18 22.5 21 26"/><path class="s" d="M27 26 Q30 22.5 33 26"/><path class="s" d="M20.5 31.5 Q24 34.5 27.5 31.5"/>',
  focused: '<path class="s w" d="M15.5 25 H20.5"/><path class="s w" d="M27.5 25 H32.5"/><path class="s" d="M21 33 H27"/>',
  surprised: '<circle class="f" cx="18" cy="24.5" r="3.2"/><circle class="f" cx="30" cy="24.5" r="3.2"/><circle class="s" cx="24" cy="33.5" r="2.6"/>',
  // Brows raised at the inner end read as worry or sorrow; lowered there they would read as anger.
  concerned: EYES + '<path class="s" d="M15 21 L20.5 20"/><path class="s" d="M33 21 L27.5 20"/><path class="s" d="M21 33.5 Q24 32 27 33.5"/>',
  sad: EYES + '<path class="s" d="M14.5 22 L20.5 19.5"/><path class="s" d="M33.5 22 L27.5 19.5"/><path class="s" d="M19 35 Q24 30 29 35"/>',
  confused: '<ellipse class="f" cx="18" cy="25" rx="2.2" ry="3"/><ellipse class="f" cx="30" cy="25.5" rx="1.4" ry="1.9"/><path class="s" d="M19 33 Q21.5 31 24 33 Q26.5 35 29 32.5"/>',
};
const BODY = '<path class="body" d="M24 8 C34 8 41 17 42 28 C43 37 36 42 24 42 C12 42 5 37 6 28 C7 17 14 8 24 8 Z"/>';
const faceSvg = (face: AvatarExpression): string => `<svg class="face" viewBox="0 0 48 48" aria-hidden="true">${BODY}${FACE[face]}</svg>`;
---

<section class="card board-card affect" id="affect" data-testid="affect-panel" data-section="emociones" aria-labelledby="affect-title">
  <header class="board-head">
    <h2 id="affect-title">Emociones en vivo</h2>
    <p>Estimaciones, no un diagnóstico.</p>
  </header>
  <div class="affect-body" id="affect-body" aria-live="polite"></div>

  <section class="legend" data-testid="mood-legend" aria-labelledby="legend-title">
    <header class="legend-head">
      <h3 id="legend-title">Luces y caras del avatar</h3>
      <p>
        Cada lectura enciende el borde del escenario con un color, cambia la cara del slime y se dice en palabras junto al avatar: el color nunca va solo. «Probar» envía una lectura de muestra a la conversación.
      </p>
    </header>
    {
      GROUPS.map((g) => (
        <div class="legend-group">
          <h4>{g.title}</h4>
          <ul class="legend-list">
            {rows
              .filter((row) => row.item.group === g.id)
              .map((row) => (
                <li class="legend-item" data-testid="mood-legend-item" data-key={row.item.key} style={row.glow.color ? `--g: ${row.glow.color}` : undefined}>
                  <span class:list={["swatch", { lit: !!row.glow.color }]} title={row.glow.color ? `Luz ${row.glow.color}` : "Sin luz"} set:html={faceSvg(row.face)} />
                  <div class="legend-text">
                    <p class="legend-headline">«{row.copy.headline}»</p>
                    <p class="legend-meta">
                      Señal: {row.item.signal} · Cara: {FACE_LABEL[row.face]}{row.glow.color ? "" : " · sin luz"}
                    </p>
                  </div>
                  <button type="button" class="btn legend-try" data-try={row.item.key} data-testid="mood-legend-try" aria-label={`Probar «${row.copy.headline}» en la conversación`}>
                    Probar <ArrowRight aria-hidden="true" />
                  </button>
                </li>
              ))}
          </ul>
        </div>
      ))
    }
  </section>
</section>

<script>
  import { navigate } from "astro:transitions/client";
  import { bind, byId, esc, icon, panel } from "../scripts/dom";
  import type { GlowKey } from "../scripts/emotion-glow";
  import { sampleEntry } from "../scripts/mood-indicator";
  import { pushAffect, valence, type AffectEntry, type ConsoleState } from "../voice/store";
  import type { AffectMethod, Sentiment, StyleId } from "../voice/types";

  const METHOD: Record<AffectMethod, string> = { text: "texto", voice: "voz", fused: "texto y voz" };

  const SENTIMENT: Record<Sentiment, string> = {
    positive: "positivo",
    neutral: "neutral",
    negative: "negativo",
    uncertain: "incierto",
  };

  const STYLE: Record<StyleId, string> = { directo: "Directo", calido: "Cálido", didactico: "Didáctico", neutro: "Neutro" };

  const W = 360;
  const H = 96;
  const PAD_L = 62;
  const PAD_R = 12;
  const Y = { 1: 16, 0: 48, "-1": 80 } as const;
  const yOf = (v: number): number => (v > 0 ? Y[1] : v < 0 ? Y["-1"] : Y[0]);

  /** Valence line: +1, 0, −1 per utterance; an uncertain reading leaves a gap. */
  function line(entries: AffectEntry[]): string {
    const pts = entries.slice(-12).map((e) => valence(e.estimate.sentiment));
    const n = pts.length;
    const x = (i: number): number => (n === 1 ? (PAD_L + W - PAD_R) / 2 : PAD_L + (i * (W - PAD_L - PAD_R)) / (n - 1));
    let d = "";
    let pen = false;
    let dots = "";
    pts.forEach((v, i) => {
      if (v === null) {
        pen = false;
        return;
      }
      d += `${pen ? "L" : "M"}${x(i).toFixed(1)} ${yOf(v)} `;
      pen = true;
      const cls = v > 0 ? "pos" : v < 0 ? "neg" : "neu";
      dots += `<circle class="${cls}" cx="${x(i).toFixed(1)}" cy="${yOf(v)}" r="${i === n - 1 ? 5.5 : 3.5}"/>`;
    });
    const summary = entries
      .slice(-12)
      .map((e) => SENTIMENT[e.estimate.sentiment])
      .join(", ");
    return `<figure class="valence-fig">
      <figcaption>Valencia por intervención</figcaption>
      <svg class="valence" viewBox="0 0 ${W} ${H}" role="img" aria-label="Línea de valencia por intervención: ${esc(summary)}">
        <g class="grid">
          <line x1="${PAD_L}" x2="${W - PAD_R}" y1="${Y[1]}" y2="${Y[1]}"/>
          <line x1="${PAD_L}" x2="${W - PAD_R}" y1="${Y[0]}" y2="${Y[0]}"/>
          <line x1="${PAD_L}" x2="${W - PAD_R}" y1="${Y["-1"]}" y2="${Y["-1"]}"/>
          <text x="0" y="${Y[1] + 4}">positivo</text>
          <text x="0" y="${Y[0] + 4}">neutral</text>
          <text x="0" y="${Y["-1"] + 4}">negativo</text>
        </g>
        <path d="${d}"/>
        ${dots}
      </svg>
    </figure>`;
  }

  function current(e: AffectEntry, s: ConsoleState): string {
    const est = e.estimate;
    const turn = s.turns.find((t) => t.turn_id === est.turn_id);
    const cues = est.cues.map((c) => `<li>${esc(c)}</li>`).join("");
    const split =
      est.discrepancy && e.channels?.text && e.channels.voice
        ? `<div class="split" data-testid="affect-discrepancy">
            <p class="split-title">${icon("split")} Texto y voz no coinciden</p>
            <dl>
              <dt>Texto</dt><dd>${esc(e.channels.text.emotion)}, ${SENTIMENT[e.channels.text.sentiment]}</dd>
              <dt>Voz</dt><dd>${esc(e.channels.voice.emotion)}, ${SENTIMENT[e.channels.voice.sentiment]}</dd>
            </dl>
          </div>`
        : "";
    return `<div class="reading sent-${est.sentiment}" data-testid="affect-reading" data-sentiment="${est.sentiment}" data-method="${est.method}" data-discrepancy="${est.discrepancy}">
      <p class="emotion">${esc(est.emotion)}</p>
      <p class="about">${turn ? `Turno ${turn.n}: ` : ""}«${esc(e.text)}»</p>
      <dl class="facts">
        <div><dt>Sentimiento</dt><dd>${SENTIMENT[est.sentiment]}</dd></div>
        <div><dt>Estado</dt><dd>${esc(est.state_hint)}</dd></div>
        <div><dt>Método</dt><dd>${METHOD[est.method]}</dd></div>
      </dl>
      ${split}
      ${cues ? `<ul class="cues" aria-label="Señales observadas">${cues}</ul>` : ""}
    </div>`;
  }

  function style(s: ConsoleState): string {
    const st = s.style;
    const origin = st.source === "preference" ? "preferencia" : st.style === "neutro" ? "por defecto" : "inferido";
    const signal = s.styleSignal
      ? `<p class="signal">${s.styleSignal.count} de ${s.styleSignal.needed} señales de ${esc(s.styleSignal.hint)}: el estilo aún no cambia.</p>`
      : "";
    return `<div class="style style-${st.style}" data-testid="style" data-style="${st.style}" data-source="${st.source}">
      <p class="style-name"><span>Estilo vigente</span> <strong>${STYLE[st.style]}</strong> <span class="tag ${st.source === "preference" ? "tag-accent" : "tag-quiet"}">${origin}</span></p>
      <p class="why">${esc(st.reason)} Desde el turno ${st.applies_from_turn}.</p>
      ${signal}
    </div>`;
  }

  panel("affect", (root) => {
    const body = byId("affect-body");

    // «Probar»: a sample reading goes through the store like the analyst's, then the
    // conversation opens to show it on the stage (the store survives the navigation).
    const onTry = (ev: MouseEvent): void => {
      const btn = (ev.target as HTMLElement | null)?.closest<HTMLButtonElement>("[data-try]");
      if (!btn) return;
      pushAffect(sampleEntry(btn.dataset.try as GlowKey, crypto.randomUUID(), performance.now()));
      void navigate("/consola");
    };
    root.addEventListener("click", onTry);

    const unbind = bind(["affect", "style", "meta"], (s) => {
      if (!body) return;
      const last = s.affect[s.affect.length - 1];
      const reading = last
        ? current(last, s) + line(s.affect)
        : `<p class="board-empty">Aquí aparece cómo suena cada intervención, a partir del ${s.voiceAnalysis ? "texto y de la voz" : "texto"}.</p>`;
      body.innerHTML = reading + style(s);
    });
    return () => {
      root.removeEventListener("click", onTry);
      unbind();
    };
  });
</script>

<style is:global>
  .affect-body {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    align-items: start;
    gap: var(--s-5);
  }

  .affect-body > .style,
  .affect-body > .board-empty {
    grid-column: 1 / -1;
  }

  .reading {
    --tone: var(--primary-ink);
    display: grid;
    gap: var(--s-3);
    min-width: 0;
  }

  .reading.sent-positive { --tone: var(--chart-strong); }
  .reading.sent-negative { --tone: var(--violet-700); }
  .reading.sent-uncertain { --tone: var(--ink-3); }

  .reading .emotion {
    font-family: var(--font-display);
    font-size: var(--t-xl);
    font-weight: var(--w-bold);
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--tone);
  }

  .reading .emotion::first-letter {
    text-transform: uppercase;
  }

  .reading .about {
    color: var(--ink-3);
    font-size: var(--t-sm);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .reading .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
  }

  .reading .facts dt,
  .reading .split dt {
    color: var(--ink-3);
    font-size: var(--t-xs);
  }

  .reading .facts dd,
  .reading .split dd {
    font-size: var(--t-sm);
    font-weight: var(--w-semibold);
  }

  .reading .split {
    display: grid;
    gap: var(--s-2);
    padding: var(--s-3) var(--s-4);
    border-radius: var(--r-md);
    background: var(--accent-soft);
  }

  .reading .split-title {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--accent-ink);
    font-size: var(--t-sm);
    font-weight: var(--w-bold);
  }

  .reading .split dl {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: 0.15rem var(--s-3);
  }

  .reading .cues {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
  }

  .reading .cues li {
    padding: 0.1rem 0.6rem;
    border-radius: var(--r-pill);
    background: var(--subtle-2);
    color: var(--ink-2);
    font-size: var(--t-xs);
  }

  .valence-fig {
    display: grid;
    gap: var(--s-2);
    min-width: 0;
  }

  .valence-fig figcaption {
    color: var(--ink-3);
    font-size: var(--t-xs);
  }

  .valence {
    width: 100%;
    max-width: 420px;
    height: auto;
    overflow: visible;
  }

  .valence .grid line {
    stroke: var(--border);
    stroke-width: 1;
  }

  .valence .grid text {
    fill: var(--ink-3);
    font-size: 13px; /* user units: 11–15 px on screen as the chart scales */
    font-family: var(--font-body);
  }

  .valence path {
    fill: none;
    stroke: var(--chart);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .valence circle {
    stroke: var(--card);
    stroke-width: 2;
  }

  /* Height already encodes the valence; tone repeats it: deep rose up, plum level, violet down. */
  .valence .pos { fill: var(--chart-strong); }
  .valence .neu { fill: var(--chart-quiet); }
  .valence .neg { fill: var(--violet-700); }

  .affect .style {
    display: grid;
    gap: var(--s-1);
    padding-top: var(--s-4);
    border-top: 1px solid var(--border);
  }

  .affect .style-name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2);
    color: var(--ink-3);
    font-size: var(--t-sm);
  }

  .affect .style-name strong {
    font-size: var(--t-md);
    color: var(--ink);
  }

  .affect .style-directo .style-name strong {
    color: var(--accent-ink);
  }

  .affect .why,
  .affect .signal {
    max-width: 62ch;
    color: var(--ink-2);
    font-size: var(--t-sm);
    line-height: 1.4;
  }

  .affect .signal {
    color: var(--accent-ink);
  }

  /* ── Legend of lights and faces ────────────────────────────────────────── */

  .affect .legend {
    display: grid;
    gap: var(--s-4);
    margin-top: var(--s-5);
    padding-top: var(--s-5);
    border-top: 1px solid var(--border);
  }

  .affect .legend-head {
    display: grid;
    gap: var(--s-1);
  }

  .affect .legend-head h3 {
    font-size: var(--t-md);
  }

  .affect .legend-head p {
    max-width: 70ch;
    color: var(--ink-2);
    font-size: var(--t-sm);
    line-height: 1.45;
  }

  .affect .legend-group {
    display: grid;
    gap: var(--s-2);
  }

  .affect .legend-group h4 {
    color: var(--ink-2);
    font-size: var(--t-sm);
    font-weight: var(--w-semibold);
  }

  .affect .legend-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
    gap: var(--s-2) var(--s-4);
  }

  .affect .legend-item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-2);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--card);
  }

  /* A tiny stage: the same pale background, lit at the edge like the real one. */
  .affect .swatch {
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    background: linear-gradient(180deg, var(--stage-top), var(--stage-bottom));
  }

  .affect .swatch.lit {
    border-color: color-mix(in srgb, var(--g) 55%, var(--border));
    box-shadow:
      inset 0 0 0 1.5px color-mix(in srgb, var(--g) 80%, transparent),
      inset 0 0 12px 2px color-mix(in srgb, var(--g) 45%, transparent),
      0 0 10px 1px color-mix(in srgb, var(--g) 40%, transparent);
  }

  .affect .face {
    width: 2.75rem;
    height: 2.75rem;
  }

  .affect .face .body {
    fill: var(--cta);
  }

  .affect .face .f {
    fill: var(--cta-ink);
  }

  .affect .face .s {
    fill: none;
    stroke: var(--cta-ink);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .affect .face .s.w {
    stroke-width: 2.6;
  }

  .affect .legend-text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .affect .legend-headline {
    color: var(--ink);
    font-weight: var(--w-semibold);
    line-height: 1.3;
  }

  .affect .legend-meta {
    color: var(--ink-3);
    font-size: var(--t-xs);
    line-height: 1.35;
  }

  .affect .legend-try {
    padding-inline: var(--s-3);
  }

  /* Nested in a card: a border, no shadow (tokens.css, elevation). */
  .affect .legend-item .btn {
    box-shadow: none;
  }
</style>
