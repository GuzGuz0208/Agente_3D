---
/**
 * Conversation screen: talk to the agent and read the conversation. That is all.
 * Everything technical (queries, timings, emotions, engine) is on /admin, which
 * reads the same store.
 */
import Base from "../layouts/Base.astro";
import AvatarStage from "../components/AvatarStage.astro";
import Chat from "../components/Chat.astro";
import IconBank from "../components/IconBank.astro";
import MoodIndicator from "../components/MoodIndicator.astro";
---

<Base title="Conversación · IPS en Vivo" description="Habla con el registro de IPS de Colombia (REPS) y lee la conversación." fill>
  <h1 class="sr-only">Conversación</h1>
  <div class="console" id="console">
    <AvatarStage />
    <MoodIndicator />
    <Chat />
  </div>
  <IconBank />
</Base>

<script>
  import { byId, panel } from "../scripts/dom";
  import { bindEmotionGlow } from "../scripts/emotion-glow";
  import { bindMoodIndicator } from "../scripts/mood-indicator";
  import * as controller from "../voice/controller";

  /** Hidden this long (another tab, phone locked) ends the conversation. */
  const HIDDEN_STOP_MS = 60_000;

  // The stage's border glows with the tone of the conversation (styles: global.css «Emotion glow»),
  // and the mood pill says it in words. The pill is bound second on purpose: when the person
  // dismisses a reading or hides the mood, its writes on the stage must land after the glow's.
  // Set up on every visit to this page and torn down before the router swaps it out.
  panel("avatar-stage", (stage) => {
    const unglow = bindEmotionGlow(stage);
    const mood = byId("mood");
    const unmood = mood ? bindMoodIndicator(mood, stage) : null;
    return () => {
      unmood?.();
      unglow();
    };
  });

  panel("console", () => {
    // Re-entering the console keeps the finished conversation on screen (and on the admin
    // board): leaving already stopped the engine, so nothing is resumed. Only «Reiniciar»
    // clears it. (Regression 2026-10-09: an automatic restart() here wiped the summary.)

    // Leaving the console ends the conversation (docs/08 §10): socket, mic, player and timers.
    let hiddenTimer: ReturnType<typeof setTimeout> | undefined;
    const leave = (): void => controller.leave();
    const onVisibility = (): void => {
      clearTimeout(hiddenTimer);
      if (document.visibilityState === "hidden") hiddenTimer = setTimeout(leave, HIDDEN_STOP_MS);
    };
    // Client-side navigation (links, back/forward): before the next page is even fetched.
    document.addEventListener("astro:before-preparation", leave);
    window.addEventListener("pagehide", leave);
    document.addEventListener("visibilitychange", onVisibility);

    // The cover page links here with ?iniciar=1 or ?q=…; consume them once.
    const url = new URL(location.href);
    const q = url.searchParams.get("q");
    const autostart = url.searchParams.has("iniciar");
    if (q || autostart) {
      url.searchParams.delete("q");
      url.searchParams.delete("iniciar");
      history.replaceState(history.state, "", url);
      if (q) controller.sendText(q);
      else void controller.start();
    }

    return () => {
      clearTimeout(hiddenTimer);
      document.removeEventListener("astro:before-preparation", leave);
      window.removeEventListener("pagehide", leave);
      document.removeEventListener("visibilitychange", onVisibility);
      leave();
    };
  });
</script>

<style>
  /* Phone and upright tablet: compact avatar on top, the mood pill, chat below, composer at the bottom edge. */
  .console {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: clamp(150px, 30dvh, 280px) auto minmax(0, 1fr);
    gap: var(--s-3);
    flex: 1;
    min-height: 0;
    padding: var(--s-3) var(--s-3) 0;
  }

  .console :global(.chat) {
    border-bottom: 0;
    border-radius: var(--r-lg) var(--r-lg) 0 0;
  }

  @media (min-width: 768px) {
    .console {
      grid-template-rows: clamp(260px, 40dvh, 520px) auto minmax(0, 1fr);
      gap: var(--s-4);
      padding: var(--s-4) var(--gutter) 0;
    }
  }

  /* Landscape tablet and desktop: avatar and chat side by side; the mood pill sits on top of the
     avatar's column, next to the stage's top edge, where the glow is brightest. */
  @media (min-width: 1024px) {
    .console {
      grid-template-columns: minmax(0, 46fr) minmax(0, 54fr);
      grid-template-rows: auto minmax(0, 1fr);
      gap: var(--s-3) var(--s-5);
      max-width: 1600px;
      width: 100%;
      margin: 0 auto;
      padding: var(--s-5) var(--gutter);
    }

    .console :global(.chat) {
      grid-column: 2;
      grid-row: 1 / -1;
      border-bottom: 1px solid var(--border);
      border-radius: var(--r-lg);
    }

    .console :global(.mood) {
      grid-column: 1;
      grid-row: 1;
    }

    .console :global(.stage-card) {
      grid-column: 1;
      grid-row: 2;
    }
  }

  /* Phone on its side: the page scrolls, so give each part a real height. */
  @media (max-height: 479px) {
    .console {
      grid-template-rows: 70dvh auto 90dvh;
    }
  }

  @media (max-height: 479px) and (min-width: 1024px) {
    .console {
      grid-template-rows: auto 100dvh;
    }
  }
</style>
